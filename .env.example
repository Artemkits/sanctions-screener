# Copy to .env (never commit real values)
# Telegram bot token from @BotFather — only needed for `python -m app.telegram_bot`
TELEGRAM_BOT_TOKEN=
# Enables POST /api/admin/update with header X-Admin-Token (leave empty to disable)
ADMIN_TOKEN=
# Where the SQLite database and downloaded XML files are kept
DATA_DIR=./data
# Re-download the lists on start-up when the database is older than this many hours
REFRESH_HOURS=24
